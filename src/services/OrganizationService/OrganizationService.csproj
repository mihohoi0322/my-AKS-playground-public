<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="../../proto/hrsystem/organization/v1/organization.proto" GrpcServices="Server" ProtoRoot="../../proto" />
    <Protobuf Include="../../proto/hrsystem/employee/v1/employee.proto" GrpcServices="Client" ProtoRoot="../../proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.64.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.64.0" />
    <PackageReference Include="Grpc.HealthCheck" Version="2.64.0" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.46.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/HRSystem.Shared/HRSystem.Shared.csproj" />
    <ProjectReference Include="..\ServiceDefaults\HRSystem.ServiceDefaults\HRSystem.ServiceDefaults.csproj" />
    <ProjectReference Include="../Shared/HRSystem.Audit.Analyzers/HRSystem.Audit.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
