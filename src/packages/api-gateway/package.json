{
  "name": "@hrsystem/api-gateway",
  "version": "0.1.0",
  "description": "HR System API Gateway — Fastify REST → gRPC proxy",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app/index.js",
    "dev": "tsx watch app/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:cov": "vitest run --coverage",
    "lint": "eslint app/ tests/",
    "lint:fix": "eslint app/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "qa": "npm run lint && npm run test && npm run typecheck",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.9.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/env": "^5.0.3",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.215.0",
    "@opentelemetry/instrumentation-ioredis": "^0.63.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.17",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "ioredis-mock": "^8.9.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.2.1"
  }
}
